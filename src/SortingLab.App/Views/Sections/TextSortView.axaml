<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SortingLab.App.Views.Controls"
             xmlns:charts="using:SortingLab.App.Views.Charts"
             x:Class="SortingLab.App.Views.Sections.TextSortView"
             MaxWidth="1100" ClipToBounds="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="0,0,8,0">
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Источник текста" Classes="h3" />
              <TextBlock Text="Загрузите TXT-файл или сгенерируйте воспроизводимый текст из словаря."
                         Classes="caption" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Загрузить TXT"
                      Classes="small"
                      Command="{Binding LoadTextCommand}"
                      IsEnabled="{Binding CanEditText}" />
              <Button Content="Очистить"
                      Classes="small ghost"
                      Command="{Binding ClearTextCommand}"
                      IsEnabled="{Binding CanEditText}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="110,110,170,Auto,*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Слов" Classes="fieldLabel" />
              <NumericUpDown Minimum="1" Maximum="50000" Increment="100" FormatString="0"
                             Value="{Binding GeneratedWordCount}"
                             IsEnabled="{Binding CanEditText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Зерно" Classes="fieldLabel" />
              <NumericUpDown Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0"
                             Value="{Binding Seed}"
                             IsEnabled="{Binding CanEditText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Язык словаря" Classes="fieldLabel" />
              <ComboBox ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}"
                        IsEnabled="{Binding CanEditText}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <Button Grid.Column="3"
                    Content="Сгенерировать текст"
                    Classes="primary"
                    VerticalAlignment="Bottom"
                    Command="{Binding GenerateTextCommand}"
                    IsEnabled="{Binding CanEditText}" />
            <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
              <TextBlock Text="{Binding SourceName}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="{Binding WordSummary}" Classes="caption" />
            </StackPanel>
          </Grid>

          <Border Classes="errorBanner" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Classes="dangerText" FontSize="12" />
          </Border>
        </StackPanel>
      </Border>

      <controls:ResponsiveTwoColumnPanel Breakpoint="2000" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="card" Padding="16">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Текст" Classes="h3" />
                <TextBlock Text="Показаны первые символы; сортировка выполняется по всем словам."
                           Classes="caption" />
              </StackPanel>
              <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top">
                <TextBlock Text="{Binding TotalWordsText, StringFormat=Слов: {0}}" FontSize="10" />
              </Border>
            </Grid>
            <TextBox Grid.Row="1"
                     Text="{Binding TextPreview}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="190"
                     MaxHeight="240"
                     FontSize="12" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Сортировка слов" Classes="h3" />
                <TextBlock Text="Единое правило: Unicode Form C, нижний регистр, ординарный порядок UTF-16."
                           Classes="caption" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Сортировать"
                        Classes="primary small"
                        Command="{Binding SortCommand}" />
                <Button Content="Отмена"
                        Classes="small ghost"
                        Command="{Binding CancelSortCommand}"
                        IsVisible="{Binding IsSorting}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Алгоритм" Classes="fieldLabel" />
                <ComboBox ItemsSource="{Binding Algorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          IsEnabled="{Binding CanEditText}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Border Grid.Column="1" Classes="pill" VerticalAlignment="Bottom" Margin="0,0,0,7">
                <TextBlock Text="{Binding SortElapsedText, StringFormat=Время: {0}}" FontSize="10" />
              </Border>
            </Grid>

            <TextBlock Text="{Binding SortMessage}" Classes="secondary" FontSize="12" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <controls:StatTile Label="Всего слов" Value="{Binding TotalWordsText}" />
              <controls:StatTile Grid.Column="1" Label="Уникальных" Value="{Binding UniqueWordsText}" />
              <controls:StatTile Grid.Column="2" Label="Время" Value="{Binding SortElapsedText}" />
            </Grid>

            <Border Classes="innerCard" Padding="12">
              <StackPanel Spacing="5">
                <TextBlock Text="Самые частые слова" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TopWords}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Text="{Binding Word}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="caption" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <SelectableTextBlock Text="{Binding SortedPreview}"
                                 Classes="mono"
                                 TextWrapping="Wrap"
                                 MaxHeight="62"
                                 FontSize="10" />
          </StackPanel>
        </Border>
      </controls:ResponsiveTwoColumnPanel>

      <Border Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Частота слов" Classes="h3" />
              <TextBlock Text="Таблица строится по отсортированному массиву: одинаковые слова уже стоят рядом."
                         Classes="caption" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SearchSummary}" Classes="caption" VerticalAlignment="Top" />
          </Grid>

          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Text="Поиск по словам" Classes="fieldLabel" />
            <Grid ColumnDefinitions="340,*" ColumnSpacing="10">
              <TextBox Text="{Binding SearchText}" Watermark="Введите слово или часть слова…" />
              <TextBlock Grid.Column="1"
                         Text="{Binding UniqueWordsText, StringFormat=Уникальных слов: {0}}"
                         Classes="caption"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>

          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding Frequencies}"
                    MinHeight="220"
                    MaxHeight="320"
                    CanUserSortColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="*" />
              <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="150" />
              <DataGridTextColumn Header="Доля" Binding="{Binding PercentText}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Сравнение производительности" Classes="h3" />
              <TextBlock Text="{Binding ExperimentInfo}" Classes="caption" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Запустить эксперименты"
                      Classes="primary small"
                      Command="{Binding RunExperimentsCommand}" />
              <Button Content="Отмена"
                      Classes="small ghost"
                      Command="{Binding CancelExperimentsCommand}"
                      IsVisible="{Binding IsExperimentRunning}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="360,110,110,Auto,*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Размеры (слов)" Classes="fieldLabel" />
              <TextBox Text="{Binding ExperimentSizesText}"
                       Watermark="100, 500, 1000, 2000, 5000"
                       IsEnabled="{Binding CanEditText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Повторов" Classes="fieldLabel" />
              <NumericUpDown Minimum="1" Maximum="20" Increment="1" FormatString="0"
                             Value="{Binding ExperimentRepeats}"
                             IsEnabled="{Binding CanEditText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Зерно" Classes="fieldLabel" />
              <NumericUpDown Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0"
                             Value="{Binding ExperimentSeed}"
                             IsEnabled="{Binding CanEditText}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Bottom">
              <ProgressBar Value="{Binding ExperimentProgress}"
                           Maximum="100"
                           IsVisible="{Binding IsExperimentRunning}" />
              <TextBlock Text="{Binding ExperimentStatus}" Classes="caption" />
            </StackPanel>
          </Grid>

          <controls:ResponsiveTwoColumnPanel Breakpoint="2000" ColumnSpacing="12" RowSpacing="12">
            <Border Classes="innerCard" Padding="8" IsVisible="{Binding HasExperimentResults}">
              <DataGrid ItemsSource="{Binding BenchmarkRows}" MaxHeight="300" CanUserSortColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Слов" Binding="{Binding WordCountText}" Width="90" />
                  <DataGridTextColumn Header="QuickSort" Binding="{Binding QuickSortText}" Width="*" />
                  <DataGridTextColumn Header="Radix Sort" Binding="{Binding RadixSortText}" Width="*" />
                  <DataGridTextColumn Header="Отношение" Binding="{Binding RatioText}" Width="130" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Border Classes="innerCard"
                    Padding="8"
                    MinHeight="260"
                    IsVisible="{Binding HasExperimentResults}">
              <charts:PerformanceChartControl Results="{Binding BenchmarkPoints}"
                                              Revision="{Binding BenchmarkRevision}"
                                              MinHeight="245" />
            </Border>
          </controls:ResponsiveTwoColumnPanel>

          <Border Classes="innerCard" Padding="18" IsVisible="{Binding !HasExperimentResults}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Результаты экспериментов появятся здесь"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Задайте размеры и нажмите «Запустить эксперименты»."
                         Classes="caption"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <controls:InfoCard Descriptor="{Binding AlgorithmInfo}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
